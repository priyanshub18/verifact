# Secrets: never commit real keys (.env.example is the committed template)
.env
.env.*
!.env.example
*.pem
*.key

frontend/.next

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

