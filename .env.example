# ---- Required: ONE LLM provider (free option first) ----
LLM_PROVIDER=groq                 # default provider; the UI can toggle per check: groq | anthropic | openai
# console.groq.com: FREE tier (rate-limited: ~30 req/min, daily token cap)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# optional separate vision model override for Groq (defaults to GROQ_MODEL, which supports vision)
GROQ_VISION_MODEL=
# optional, paid (console.anthropic.com). Code path kept; enable later.
ANTHROPIC_API_KEY=
# optional, paid
OPENAI_API_KEY=
# optional override for the default provider
LLM_MODEL=

# ---- Free evidence sources: no keys needed ----
# DuckDuckGo/Bing web search (unofficial), GDELT news, Wikipedia, PubMed, Crossref are always on.

# ---- Optional paid/keyed sources (code kept, off unless a key is set) ----
# tavily.com: ~1,000 free searches/month
TAVILY_API_KEY=
# brave.com/search/api
BRAVE_API_KEY=
# free: Google Cloud console > enable "Fact Check Tools API" (existing fact-checks)
GOOGLE_FACTCHECK_API_KEY=

# ---- Optional ----
# ncbi.nlm.nih.gov/account: raises PubMed limit 3 -> 10 req/s, free
NCBI_API_KEY=
# Crossref "polite pool"
CONTACT_EMAIL=
# idir.uta.edu/claimbuster/api (free on request)
CLAIMBUSTER_API_KEY=
# e.g. http://ml-service:8100 (milestone 2+)
ML_SERVICE_URL=
# milestone 2: reverse image search (1,000 free units/month)
GOOGLE_VISION_API_KEY=
# milestone 2: paid
TINEYE_API_KEY=
# milestone 2: 100 free searches/month
SERPAPI_KEY=
# milestone 3: pyannote diarization (accept model licence on huggingface.co)
HF_TOKEN=

# ---- Runtime (defaults are fine) ----
# Leave both unset for a zero-dependency local run (SQLite + in-process jobs). Docker Compose sets Postgres + Redis itself.
# DATABASE_URL=postgresql+asyncpg://verifact:verifact@localhost:5432/verifact
# REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
