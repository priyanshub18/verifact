# ---- Required: ONE LLM provider (free option first) ----
LLM_PROVIDER=groq                 # default provider; the UI can toggle per check: groq | anthropic | openai
GROQ_API_KEY=                     # console.groq.com: FREE tier (rate-limited: ~30 req/min, daily token cap)
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=                # optional, paid (console.anthropic.com). Code path kept; enable later.
OPENAI_API_KEY=                   # optional, paid
LLM_MODEL=                        # optional override for the default provider

# ---- Free evidence sources: no keys needed ----
# DuckDuckGo/Bing web search (unofficial), GDELT news, Wikipedia, PubMed, Crossref are always on.

# ---- Optional paid/keyed sources (code kept, off unless a key is set) ----
TAVILY_API_KEY=                   # tavily.com: ~1,000 free searches/month
BRAVE_API_KEY=                    # brave.com/search/api
GOOGLE_FACTCHECK_API_KEY=         # free: Google Cloud console > enable "Fact Check Tools API" (existing fact-checks)

# ---- Optional ----
NCBI_API_KEY=                     # ncbi.nlm.nih.gov/account: raises PubMed limit 3 -> 10 req/s, free
CONTACT_EMAIL=                    # Crossref "polite pool"
CLAIMBUSTER_API_KEY=              # idir.uta.edu/claimbuster/api (free on request)
ML_SERVICE_URL=                   # e.g. http://ml-service:8100 (milestone 2+)
GOOGLE_VISION_API_KEY=            # milestone 2: reverse image search (1,000 free units/month)
TINEYE_API_KEY=                   # milestone 2: paid
SERPAPI_KEY=                      # milestone 2: 100 free searches/month
HF_TOKEN=                         # milestone 3: pyannote diarization (accept model licence on huggingface.co)

# ---- Runtime (defaults are fine) ----
# Leave both unset for a zero-dependency local run (SQLite + in-process jobs). Docker Compose sets Postgres + Redis itself.
# DATABASE_URL=postgresql+asyncpg://verifact:verifact@localhost:5432/verifact
# REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
